<%- include('../layouts/header') %>

<div class="container-fluid page-body-wrapper">

    <%- include('../layouts/sidebar') %>

    <div class="main-panel">

        <div class="content-wrapper">

            <div class="page-header">

                <h3 class="page-title">
                    Manage Notice
                </h3>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/dashboard">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active">
                            Manage Notice
                        </li>
                    </ol>
                </nav>

            </div>

            <div class="row">

                <div class="col-md-12 grid-margin stretch-card">

                    <div class="card">

                        <div class="card-body">

                            <div class="d-sm-flex align-items-center mb-4">

                                <h4 class="card-title mb-sm-0">
                                    Manage Notice
                                </h4>

                                <a href="/notices/add" class="btn btn-primary ml-auto">
                                    Add Notice
                                </a>

                            </div>

                            <% if(success_msg){ %>
                                <div class="alert alert-success">
                                    <%= success_msg %>
                                </div>
                            <% } %>

                            <% if(error_msg){ %>
                                <div class="alert alert-danger">
                                    <%= error_msg %>
                                </div>
                            <% } %>

                            <div class="table-responsive border rounded p-1">

                                <table class="table table-bordered table-hover">

                                    <thead>

                                        <tr>

                                            <th>S.No</th>
                                            <th>Notice Title</th>
                                            <th>Course</th>
                                            <th>Notice Message</th>
                                            <th>Notice Date</th>
                                            <th>Action</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        <% if(notices.length > 0){ %>

                                            <% notices.forEach((notice,index)=>{ %>

                                                <tr>

                                                    <td>
                                                        <%= index + 1 %>
                                                    </td>

                                                    <td>
                                                        <%= notice.nottitle %>
                                                    </td>

                                                    <td>
                                                        <%= notice.courseId ? notice.courseId.name : "N/A" %>
                                                    </td>

                                                    <td>
                                                        <%= notice.notmsg %>
                                                    </td>

                                                    <td>
                                                        <%= new Date(notice.createdAt).toLocaleDateString() %>
                                                    </td>

                                                    <td>

                                                        <a
                                                            href="/notices/edit/<%= notice._id %>"
                                                            class="btn btn-warning btn-sm">
                                                            <i class="fa-solid fa-pen"></i>
                                                        </a>

                                                        <a
                                                            href="/notices/delete/<%= notice._id %>"
                                                            onclick="return confirm('Do you really want to delete this notice?')"
                                                            class="btn btn-danger btn-sm">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </a>

                                                    </td>

                                                </tr>

                                            <% }) %>

                                        <% } else { %>

                                            <tr>

                                                <td colspan="6" class="text-center">
                                                    No Notices Found
                                                </td>

                                            </tr>

                                        <% } %>

                                    </tbody>

                                </table>

                            </div>

                            <div class="mt-3">

                                <ul class="pagination">

                                    <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">

                                        <a class="page-link" href="?page=<%= currentPage - 1 %>">
                                            Previous
                                        </a>

                                    </li>

                                    <li class="page-item active">

                                        <span class="page-link">
                                            <%= currentPage %>
                                        </span>

                                    </li>

                                    <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">

                                        <a class="page-link" href="?page=<%= currentPage + 1 %>">
                                            Next
                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <%- include('../layouts/footer') %>

    </div>

</div>