<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | EduSphere</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #2447ff, #8a2be2);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .container-box {
            width: 1100px;
            height: 700px;
            display: flex;
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, .25);
            background: #fff;
        }

        .left-panel {
            width: 40%;
            background: linear-gradient(rgba(32, 55, 214, .85), rgba(97, 48, 224, .9)),
                url('/images/background.jpg');
            background-size: cover;
            background-position: center;
            color: #fff;
            padding: 60px 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .logo {
            font-size: 35px;
            font-weight: bold;
            margin-bottom: 40px;
        }

        .logo i {
            margin-right: 10px;
        }

        .left-panel h1 {
            font-size: 42px;
            margin-bottom: 20px;
            font-weight: 700;
        }

        .left-panel p {
            font-size: 20px;
            line-height: 35px;
            opacity: .9;
        }

        .right-panel {
            width: 60%;
            padding: 40px 60px;
            overflow-y: auto;
        }

        .icon-box {
            width: 90px;
            height: 90px;
            background: linear-gradient(135deg, #5d5dff, #d946ef);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 35px;
            margin: auto;
        }

        h2 {
            text-align: center;
            margin-top: 20px;
            font-size: 45px;
            font-weight: 700;
        }

        .subtitle {
            text-align: center;
            color: #777;
            margin-bottom: 30px;
        }

        .form-control,
        .form-select {
            height: 58px;
            border-radius: 12px;
            padding-left: 45px;
            border: 1px solid #ddd;
        }

        .input-group {
            position: relative;
        }

        .input-group i {
            position: absolute;
            left: 18px;
            top: 20px;
            color: #777;
            z-index: 99;
        }

        .btn-register {
            width: 100%;
            height: 58px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(90deg, #355cff, #d946ef);
            color: #fff;
            font-size: 20px;
            font-weight: bold;
            margin-top: 20px;
            transition: .3s;
        }

        .btn-register:hover {
            transform: translateY(-3px);
        }

        .divider {
            display: flex;
            align-items: center;
            margin: 25px 0;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #ddd;
        }

        .divider span {
            margin: 0 15px;
            color: #888;
        }

        .login-text {
            text-align: center;
        }

        .login-text a {
            text-decoration: none;
            color: #6b3df7;
            font-weight: 600;
        }

        @media(max-width:992px) {

            .container-box {
                flex-direction: column;
                width: 95%;
                height: auto;
            }

            .left-panel {
                width: 100%;
                text-align: center;
            }

            .right-panel {
                width: 100%;
            }
        }
    </style>

</head>

<body>

    <div class="container-box">

        <div class="left-panel">

            <div class="logo">
                <i class="fa-solid fa-graduation-cap"></i>
                EduSphere
            </div>

            <h1>Join EduSphere</h1>

            <p>
                Create your account and take the first step towards a better learning experience.
            </p>

        </div>

        <div class="right-panel">

            <div class="icon-box">
                <i class="fa-solid fa-user-plus"></i>
            </div>

            <h2>REGISTER NOW</h2>

            <p class="subtitle">
                Fill in the details below to create your account
            </p>

            <form action="/register" method="POST">

                <div class="mb-3 input-group">
                    <i class="fa-regular fa-user"></i>
                    <input type="text" name="name" class="form-control" placeholder="Full Name" required>
                </div>

                <div class="mb-3 input-group">
                    <i class="fa-regular fa-envelope"></i>
                    <input type="email" name="email" class="form-control" placeholder="Email Address" required>
                </div>

                <div class="mb-3 input-group">
                    <i class="fa-solid fa-phone"></i>
                    <input type="text" name="phone" class="form-control" placeholder="Phone Number" required>
                </div>

                <div class="mb-3 input-group">
                    <i class="fa-solid fa-venus-mars"></i>

                    <select name="gender" class="form-select" required>
                        <option value="">Select Gender</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>
                    </select>

                </div>

                <div class="mb-3 input-group">
                    <i class="fa-solid fa-calendar"></i>
                    <input type="number" name="age" class="form-control" placeholder="Age" required>
                </div>
                <div class="mb-3 input-group">
                    <i class="fa-solid fa-lock"></i>

                    <input type="password" name="password" class="form-control" placeholder="Password" required>
                </div>
                <div class="mb-3 input-group">
                    <i class="fa-solid fa-lock"></i>

                    <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm Password"
                        required>
                </div>

                <div class="form-check mt-3">

                    <input class="form-check-input" type="checkbox" required>

                    <label class="form-check-label">
                        I agree to the
                        <a href="#">Terms of Service</a>
                        &
                        <a href="#">Privacy Policy</a>
                    </label>

                </div>

                <button class="btn-register">
                    REGISTER NOW
                    <i class="fa-solid fa-arrow-right ms-2"></i>
                </button>

            </form>

            <div class="divider">
                <span>OR</span>
            </div>

            <div class="login-text">

                Already have an account?

                <a href="/login">
                    Log In
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </div>

        </div>

    </div>

</body>

</html>