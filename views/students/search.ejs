<%- include('../layouts/header') %>
<div class="container-fluid page-body-wrapper">
    <%- include('../layouts/sidebar') %>

        <div class="container-fluid page-body-wrapper">
            <div class="main-panel">
                <div class="content-wrapper">

                    <div class="page-header">
                        <h3 class="page-title">Search Student</h3>

                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/dashboard">Dashboard</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    Search Student
                                </li>
                            </ol>
                        </nav>
                    </div>

                    <div class="row">
                        <div class="col-md-12 grid-margin stretch-card">

                            <div class="card">
                                <div class="card-body">

                                    <form action="/students/search" method="GET">
                                        <div class="row">
                                            <div class="col-lg-10 col-md-9 mb-2">
                                                <input type="text" name="keyword" class="form-control"
                                                    placeholder="Search by Student ID" value="<%= keyword || '' %>"
                                                    required>
                                            </div>

                                            <div class="col-lg-2 col-md-3">
                                                <button type="submit" class="btn btn-primary btn-block">
                                                    Search
                                                </button>
                                            </div>
                                        </div>
                                    </form>

                                    <% if(typeof keyword !=='undefined' && keyword){ %>

                                        <div class="d-sm-flex align-items-center mb-4 mt-4">
                                            <h4>
                                                Result against
                                                "<%= keyword %>"
                                            </h4>
                                        </div>

                                        <div class="table-responsive w-100">

                                            <table class="table table-bordered table-hover w-100">
                                                <thead>
                                                    <tr>
                                                        <th>S.No</th>
                                                        <th>Student ID</th>
                                                        <th>Course</th>
                                                        <th>Student Name</th>
                                                        <th>Email</th>
                                                        <th>Admission Date</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>

                                                <tbody>

                                                    <% if(students.length> 0){ %>

                                                        <% students.forEach((item,index)=>{ %>

                                                            <tr>

                                                                <td>
                                                                    <%= (currentPage-1) * limit + index + 1 %>
                                                                </td>

                                                                <td>
                                                                    <%= item.studentId %>
                                                                </td>

                                                                <td>
                                                                    <%= item.course %>
                                                                </td>

                                                                <td>
                                                                    <%= item.name %>
                                                                </td>

                                                                <td>
                                                                    <%= item.email %>
                                                                </td>

                                                                <td>
                                                                    <%= new Date(item.createdAt).toLocaleDateString() %>
                                                                </td>

                                                                <td>

                                                                    <a href="/students/edit/<%= item._id %>"
                                                                        class="btn btn-primary btn-sm">
                                                                        <i class="fa-solid fa-eye"></i>
                                                                    </a>

                                                                    <a href="/students/delete/<%= item._id %>"
                                                                        onclick="return confirm('Do you really want to delete?')"
                                                                        class="btn btn-danger btn-sm">
                                                                        <i class="fa-solid fa-trash"></i>
                                                                    </a>

                                                                </td>

                                                            </tr>

                                                            <% }) %>

                                                                <% } else { %>

                                                                    <tr>
                                                                        <td colspan="7" class="text-center">
                                                                            No record found against this search
                                                                        </td>
                                                                    </tr>

                                                                    <% } %>

                                                </tbody>
                                            </table>

                                        </div>

                                        <% if(totalPages> 1){ %>

                                            <div class="mt-3">
                                                <ul class="pagination">

                                                    <li class="page-item">
                                                        <a class="page-link"
                                                            href="/students/search?page=1&keyword=<%= keyword %>">
                                                            First
                                                        </a>
                                                    </li>

                                                    <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                                                        <a class="page-link"
                                                            href="/students/search?page=<%= currentPage-1 %>&keyword=<%= keyword %>">
                                                            Prev
                                                        </a>
                                                    </li>

                                                    <li class="page-item disabled">
                                                        <span class="page-link">
                                                            <%= currentPage %> / <%= totalPages %>
                                                        </span>
                                                    </li>

                                                    <li
                                                        class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                                        <a class="page-link"
                                                            href="/students/search?page=<%= currentPage+1 %>&keyword=<%= keyword %>">
                                                            Next
                                                        </a>
                                                    </li>

                                                    <li class="page-item">
                                                        <a class="page-link"
                                                            href="/students/search?page=<%= totalPages %>&keyword=<%= keyword %>">
                                                            Last
                                                        </a>
                                                    </li>

                                                </ul>
                                            </div>

                                            <% } %>

                                                <% } %>

                                </div>
                            </div>

                        </div>
                    </div>

                </div>

                <%- include('../layouts/footer') %>
            </div>
        </div>