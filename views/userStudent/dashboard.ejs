<%- include('../layouts/studentHeader') %>


    <div class="container-fluid page-body-wrapper">


        <%- include('../layouts/studentSidebar') %>
            <div class="main-panel">
                <div class="content-wrapper">

                    <div class="page-header d-flex justify-content-between align-items-center">

                        <div>
                            <h3 class="page-title">
                                Student Dashboard
                            </h3>

                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item active">
                                        Dashboard
                                    </li>
                                </ol>
                            </nav>
                        </div>

                        <!-- Notification Bell -->
                        <div class="dropdown">

                            <button class="btn btn-light position-relative" data-toggle="dropdown">

                                <i class="fa-solid fa-bell" style="font-size:23px;"></i>

                                <% if(unreadCount> 0){ %>
                                    <span id="notificationCount" class="badge badge-danger position-absolute"
                                        style="top:0;right:0;">
                                        <%= unreadCount %>
                                    </span>
                                    <% } %>

                            </button>

                            <div class="dropdown-menu dropdown-menu-right"
                                style="width:350px;max-height:400px;overflow:auto;">

                                <h6 class="dropdown-header">
                                    Notifications
                                </h6>

                                <div id="notificationList">

                                    <% if(notifications.length===0){ %>

                                        <p class="text-center text-muted">
                                            No Notifications
                                        </p>

                                        <% }else{ %>

                                            <% notifications.forEach(notification=>{ %>

                                                <div class="dropdown-item notification-item"
                                                    data-id="<%= notification._id %>">

                                                    <strong>
                                                        🔔 <%= notification.title %>
                                                    </strong>

                                                    <p class="mb-1">
                                                        <%= notification.message %>
                                                    </p>

                                                    <small class="text-muted">
                                                        <%= notification.createdAt.toLocaleString() %>
                                                    </small>

                                                    <hr>

                                                </div>

                                                <% }) %>

                                                    <% } %>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Welcome Card -->

                    <div class="row">

                        <div class="col-md-12 grid-margin">

                            <div class="card">

                                <div class="card-body">

                                    <h3>
                                        Welcome,
                                        <span class="text-primary">
                                            <%= user.name %>
                                        </span>
                                    </h3>

                                    <hr>

                                    <div class="row">

                                        <div class="col-md-3">

                                            <p><strong>Name</strong></p>

                                            <p>
                                                <%= student ? student.name : user.name %>
                                            </p>

                                        </div>

                                        <div class="col-md-3">

                                            <p><strong>Email</strong></p>

                                            <p>
                                                <%= student ? student.email : user.email %>
                                            </p>

                                        </div>

                                        <div class="col-md-3">

                                            <p><strong>Phone</strong></p>

                                            <p>
                                                <%= student ? student.phone : user.phone %>
                                            </p>

                                        </div>

                                        <div class="col-md-3">

                                            <p><strong>Gender</strong></p>

                                            <p>
                                                <%= student ? student.gender : user.gender %>
                                            </p>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Dashboard Cards -->

                    <div class="row">

                        <div class="col-xl-3 col-lg-6 col-md-6 grid-margin stretch-card">

                            <div class="card bg-primary text-white">

                                <div class="card-body">

                                    <h4>Total Courses</h4>

                                    <h2>
                                        <%= totalCourses %>
                                    </h2>

                                </div>

                            </div>

                        </div>

                        <div class="col-xl-3 col-lg-6 col-md-6 grid-margin stretch-card">

                            <div class="card bg-success text-white">

                                <div class="card-body">

                                    <h4>Notices</h4>

                                    <h2>
                                        <%= totalNotices %>
                                    </h2>

                                </div>

                            </div>

                        </div>

                        <div class="col-xl-3 col-lg-6 col-md-6 grid-margin stretch-card">

                            <div class="card bg-warning text-white">

                                <div class="card-body">

                                    <h4>Attendance</h4>

                                    <h2>--</h2>

                                    <small>Coming Soon</small>

                                </div>

                            </div>

                        </div>

                        <div class="col-xl-3 col-lg-6 col-md-6 grid-margin stretch-card">

                            <div class="card bg-danger text-white">

                                <div class="card-body">

                                    <h4>Exam Result</h4>

                                    <h2>--</h2>

                                    <small>Coming Soon</small>

                                </div>

                            </div>

                        </div>

                    </div>




                </div>

            </div>

    </div>

    <!-- Notification Popup -->
    <div id="noticePopup" class="alert alert-primary shadow" style="
            display:none;
            position:fixed;
            top:20px;
            right:20px;
            width:350px;
            z-index:9999;
            border-radius:10px;
        ">
    </div>

    <script src="/socket.io/socket.io.js"></script>

    <script>

        const socket = io();


        const badge = document.getElementById("notificationCount");
        const list = document.getElementById("notificationList");

        socket.on("connect", () => {
            console.log("Socket Connected:", socket.id);
        });

        socket.on("newNotice", (data) => {

            // Increase notification count
            const badge = document.getElementById("notificationCount");

            if (badge) {

                badge.innerHTML = parseInt(badge.innerHTML) + 1;

            } else {

                const span = document.createElement("span");

                span.id = "notificationCount";

                span.className = "badge badge-danger position-absolute";

                span.style.top = "0";

                span.style.right = "0";

                span.innerHTML = "1";

                document.querySelector(".btn.position-relative")
                    .appendChild(span);

            }

            // Add notification to dropdown
            if (count === 1) {
                list.innerHTML = "";
            }

            const item = document.createElement("div");

            item.className = "dropdown-item";

            item.innerHTML = `
        <strong>🔔 ${data.title}</strong>
        <br>
        <small>${data.message}</small>
        <hr>
    `;

            list.prepend(item);
            item.style.cursor = "pointer";

            item.onclick = async () => {

                await fetch("/student/notification/read/" + data.id, {
                    method: "POST"
                });

                const badge = document.getElementById("notificationCount");

                if (badge) {

                    let value = parseInt(badge.innerHTML) - 1;

                    if (value <= 0) {

                        badge.remove();

                    } else {

                        badge.innerHTML = value;

                    }

                }

            };
            // Show popup
            const popup = document.getElementById("noticePopup");

            popup.innerHTML = `
        <h5>🔔 ${data.title}</h5>
        <hr>
        <p>${data.message}</p>
    `;

            popup.style.display = "block";

            setTimeout(() => {
                popup.style.display = "none";
            }, 5000);

        });

        document.querySelectorAll(".notification-item").forEach(item => {

            item.onclick = async () => {

                const id = item.dataset.id;

                await fetch("/student/notification/read/" + id, {
                    method: "POST"
                });

                const badge = document.getElementById("notificationCount");

                if (badge) {

                    let value = parseInt(badge.innerHTML) - 1;

                    if (value <= 0) {

                        badge.remove();

                    } else {

                        badge.innerHTML = value;

                    }

                }

            };

        });

    </script>


    <%- include('../layouts/footer') %>