<%- include('../layouts/header') %>

<div class="container-fluid page-body-wrapper">

    <%- include('../layouts/sidebar') %>

    <div class="main-panel">

        <div class="content-wrapper">

            <div class="page-header">

                <h3 class="page-title">
                    Between Dates Reports
                </h3>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/dashboard">Dashboard</a>
                        </li>

                        <li class="breadcrumb-item active">
                            Between Dates Reports
                        </li>
                    </ol>
                </nav>

            </div>

            <div class="row">

                <div class="col-md-12 grid-margin stretch-card">

                    <div class="card">

                        <div class="card-body">

                            <div class="d-sm-flex align-items-center mb-4">

                                <h5 class="text-primary mx-auto">
                                    Report from <%= fromDate %> to <%= toDate %>
                                </h5>

                            </div>

                            <div class="table-responsive border rounded p-1">

                                <table class="table">

                                    <thead>

                                        <tr>
                                            <th>S.No</th>
                                            <th>Student ID</th>
                                            <th>Student Class</th>
                                            <th>Student Name</th>
                                            <th>Student Email</th>
                                            <th>Admission Date</th>
                                            <th>Action</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        <% students.forEach((student,index)=>{ %>

                                            <tr>

                                                <td>
                                                    <%= (currentPage - 1) * limit + index + 1 %>
                                                </td>

                                                <td>
                                                    <%= student.stuId %>
                                                </td>

                                                <td>
                                                    <%= student.studentClass?.className %>
                                                    <%= student.studentClass?.section %>
                                                </td>

                                                <td>
                                                    <%= student.studentName %>
                                                </td>

                                                <td>
                                                    <%= student.studentEmail %>
                                                </td>

                                                <td>
                                                    <%= student.dateOfAdmission.toDateString() %>
                                                </td>

                                                <td>

                                                    <a href="/students/edit/<%= student._id %>">
                                                        <i class="icon-eye"></i>
                                                    </a>

                                                    ||

                                                    <a href="/students/delete/<%= student._id %>"
                                                        onclick="return confirm('Do you really want to delete?')">

                                                        <i class="icon-trash"></i>

                                                    </a>

                                                </td>

                                            </tr>

                                        <% }) %>

                                    </tbody>

                                </table>

                            </div>

                            <div class="mt-3">

                                <ul class="pagination">

                                    <li class="page-item">
                                        <a class="page-link"
                                            href="?page=1&fromdate=<%= fromDate %>&todate=<%= toDate %>">
                                            First
                                        </a>
                                    </li>

                                    <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">

                                        <a class="page-link"
                                            href="?page=<%= currentPage - 1 %>&fromdate=<%= fromDate %>&todate=<%= toDate %>">

                                            Prev

                                        </a>

                                    </li>

                                    <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">

                                        <a class="page-link"
                                            href="?page=<%= currentPage + 1 %>&fromdate=<%= fromDate %>&todate=<%= toDate %>">

                                            Next

                                        </a>

                                    </li>

                                    <li class="page-item">

                                        <a class="page-link"
                                            href="?page=<%= totalPages %>&fromdate=<%= fromDate %>&todate=<%= toDate %>">

                                            Last

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <%- include('../layouts/footer') %>

    </div>

</div>