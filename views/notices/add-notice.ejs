<%- include('../layouts/header') %>

    <div class="container-fluid page-body-wrapper">

        <%- include('../layouts/sidebar') %>

            <div class="main-panel">

                <div class="content-wrapper">

                    <div class="page-header">
                        <h3 class="page-title">Add Notice</h3>

                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/dashboard">Dashboard</a>
                                </li>
                                <li class="breadcrumb-item active">
                                    Add Notice
                                </li>
                            </ol>
                        </nav>
                    </div>

                    <div class="row">

                        <div class="col-12 grid-margin stretch-card">

                            <div class="card">

                                <div class="card-body">

                                    <h4 class="card-title text-center">Add Notice</h4>

                                    <% if(success){ %>
                                        <div class="alert alert-success">
                                            <%= success %>
                                        </div>
                                        <% } %>

                                            <% if(error){ %>
                                                <div class="alert alert-danger">
                                                    <%= error %>
                                                </div>
                                                <% } %>

                                                    <form class="forms-sample" method="POST" action="/notices/add">

                                                        <div class="form-group">
                                                            <label>Notice Title</label>

                                                            <input type="text" name="nottitle" class="form-control"
                                                                required>
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Notice For (Course)</label>

                                                            <select name="courseId" class="form-control" required>

                                                                <option value="">Select Course</option>

                                                                <% courses.forEach(course=> { %>

                                                                    <option value="<%= course._id %>">
                                                                        <%= course.name %>
                                                                    </option>

                                                                    <% }) %>

                                                            </select>
                                                        </div>

                                                        <div class="form-group">
                                                            <label>Notice Message</label>

                                                            <textarea name="notmsg" class="form-control" rows="5"
                                                                required></textarea>
                                                        </div>

                                                        <button type="submit" class="btn btn-primary mr-2">
                                                            Add Notice
                                                        </button>

                                                        <a href="/notices/add" class="btn btn-secondary">
                                                            Cancel
                                                        </a>

                                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <%- include('../layouts/footer') %>

            </div>

    </div>