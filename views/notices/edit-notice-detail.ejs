<%- include('../layouts/header') %>

    <div class="container-fluid page-body-wrapper">

        <%- include('../layouts/sidebar') %>

            <div class="main-panel">

                <div class="content-wrapper">

                    <div class="page-header">

                        <h3 class="page-title">
                            Update Notice
                        </h3>

                        <nav aria-label="breadcrumb">

                            <ol class="breadcrumb">

                                <li class="breadcrumb-item">
                                    <a href="/dashboard">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="breadcrumb-item active">
                                    Update Notice
                                </li>

                            </ol>

                        </nav>

                    </div>

                    <div class="row">

                        <div class="col-12 grid-margin stretch-card">

                            <div class="card">

                                <div class="card-body">

                                    <h4 class="card-title text-center">
                                        Update Notice
                                    </h4>

                                    <form class="forms-sample" method="POST" action="/notices/update/<%= notice._id %>">

                                        <div class="form-group">

                                            <label>
                                                Notice Title
                                            </label>

                                            <input type="text" name="nottitle" class="form-control"
                                                value="<%= notice.noticeTitle %>" required>

                                        </div>

                                        <div class="form-group">

                                            <label>
                                                Notice For
                                            </label>

                                            <select name="courseId" class="form-control" required>

                                                <% courses.forEach(course=> { %>

                                                    <option value="<%= course._id %>" <%=notice.courseId &&
                                                        notice.courseId.toString()===course._id.toString() ? "selected"
                                                        : "" %>>
                                                        <%= course.name %>
                                                    </option>

                                                    <% }) %>

                                            </select>

                                        </div>

                                        <div class="form-group">

                                            <label>
                                                Notice Message
                                            </label>

                                            <textarea name="notmsg" class="form-control" rows="5"
                                                required><%= notice.noticeMsg %></textarea>

                                        </div>

                                        <button type="submit" class="btn btn-primary mr-2">
                                            Update
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <%- include('../layouts/footer') %>

            </div>

    </div>